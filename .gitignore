# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Serwist generated service worker
/public/sw.js
/public/swe-worker-*.js

# misc
.DS_Store
*.pem

# kaikki.org English Wiktionary extract (~3.1GB). Not downloaded by the build.
/scripts/kaikki.org-dictionary-English.jsonl
/scripts/kaikki-en.jsonl
# Norvig word frequency list (~5MB) for rarity tiers.
/scripts/count_1w.txt

# Uncompressed word list. The app ships public/dictionary/english-words.json.gz.
/public/dictionary/english-words.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
